        "software",
        "opengl-hw"
      ],
      "default": "software",
      "description": "setting.renderer.about"
    },
    {
      "name": "internal_resolution",
      "display": "setting.internal_resolution",
      "type": "enum",
      "options": [
        "1x",
        "2x",
        "3x",
        "4x"
      ],
      "default": "1x",
      "description": "setting.internal_resolution.about"
    },
    {
      "name": "username",
      "display": "setting.username",
