      "default": "",
      "description": "setting.username.about"
    },
    {
      "name": "layout",
      "display": "setting.layout",
      "type": "enum",
      "options": [
        "stacked",
        "single",
        "large",
        "side-by-side"
      ],
      "default": "stacked",
      "description": "setting.layout.about"
    },
    {
      "name": "swap_screens",
      "display": "setting.swap_screens",
      "type": "bool",
      "default": false,
      "description": "setting.swap_screens.about"
    },
    {
      "name": "upright",
      "display": "setting.upright",
      "type": "bool",
      "default": false,
      "description": "setting.upright.about"
    },
    {
      "name": "large_screen_proportion",
      "display": "setting.large_screen_proportion",
