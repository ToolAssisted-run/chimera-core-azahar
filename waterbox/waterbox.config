  "settings": [
    {
      "name": "model",
      "display": "setting.model",
      "type": "enum",
      "options": [
        "new3ds",
        "old3ds"
      ],
      "default": "new3ds",
      "description": "setting.model.about"
    },
    {
      "name": "region",
      "display": "setting.region",
      "type": "enum",
      "options": [
        "auto",
        "jpn",
        "usa",
        "eur",
        "aus",
        "chn",
        "kor",
        "twn"
      ],
      "default": "auto",
      "description": "setting.region.about"
    },
    {
      "name": "rtc_start",
      "display": "setting.rtc_start",
      "type": "int",
      "default": 946684800,
      "min": 946684800,
      "max": 2145916800,
      "description": "setting.rtc_start.about"
    },
    {
      "name": "cpu",
      "display": "setting.cpu",
      "type": "enum",
      "options": [
        "jit",
        "interpreter"
      ],
      "default": "jit",
      "description": "setting.cpu.about"
    },
    {
      "name": "cpu_clock",
      "display": "setting.cpu_clock",
      "type": "int",
      "default": 100,
      "min": 5,
      "max": 400,
      "description": "setting.cpu_clock.about"
    },
    {
      "name": "savedata_commit_ms",
      "display": "setting.savedata_commit_ms",
      "type": "int",
      "default": 100,
      "min": 0,
      "max": 10000,
      "description": "setting.savedata_commit_ms.about"
    },
    {
