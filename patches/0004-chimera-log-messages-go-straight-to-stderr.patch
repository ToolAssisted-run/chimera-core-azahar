+#ifdef CHIMERA_CORE
+/// chimera: no backend thread and no log file - a Chimera machine is a
+/// deterministic machine in a sandbox, and upstream's backend is a host thread
+/// writing into the user folder. Messages at or above `level` go straight to
+/// stderr on the thread that logs them; below it they are dropped. Without a
+/// call only Critical ones print, as upstream does before initialization.
+void SetDirectLevel(Level level);
+#endif
+
 /**
  * The global filter will prevent any messages from even being processed if they are filtered.
  */
