+template <class T>
+typename T::Surface& RasterizerCache<T>::ChimeraAdopt(const ChimeraSurfaceRecord& record) {
+    // Registered is RegisterSurface's to set, Picked is a search's own mark, and
+    // Tracked says a texture cube holds this face: this cache holds no cube yet
+    const SurfaceFlagBits flags =
+        record.flags & ~(SurfaceFlagBits::Registered | SurfaceFlagBits::Picked |
+                         SurfaceFlagBits::Tracked);
+    const SurfaceId surface_id = slot_surfaces.insert(runtime, record.params, flags);
+    Surface& surface = slot_surfaces[surface_id];
+    surface.fill_size = record.fill_size;
+    surface.fill_data = record.fill_data;
+    surface.invalid_regions.clear();
+    for (u32 i = 0; i < record.invalid_count; i++) {
+        surface.invalid_regions.insert(
+            SurfaceInterval{record.invalid[2 * i], record.invalid[2 * i + 1]});
+    }
+    RegisterSurface(surface_id);
+    surface.chimera_serial = record.serial;
+    surface.modification_tick = record.tick;
+    return surface;
+}
+#endif
