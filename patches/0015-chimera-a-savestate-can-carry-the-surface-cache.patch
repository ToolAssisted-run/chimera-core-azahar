+
+u32 Surface::ChimeraBytesPerPixel() const {
+    if (!textures[0].handle) {
+        return 0;
+    }
+    switch (tuple.type) {
+    case GL_UNSIGNED_BYTE:
+        return tuple.format == GL_BGR || tuple.format == GL_RGB ? 3 : 4;
+    case GL_UNSIGNED_SHORT:
+    case GL_UNSIGNED_SHORT_5_5_5_1:
+    case GL_UNSIGNED_SHORT_5_6_5:
+    case GL_UNSIGNED_SHORT_4_4_4_4:
+        return 2;
+    case GL_UNSIGNED_INT:
+    case GL_UNSIGNED_INT_8_8_8_8:
+    case GL_UNSIGNED_INT_24_8:
+        return 4;
+    default:
+        UNREACHABLE_MSG("chimera: a surface in a format no state can carry");
+    }
+}
+
+void Surface::ChimeraRead(u32 level, u32 y, u32 rows, void* out, std::size_t size) {
+    const u32 width = ChimeraWidth(level);
+    glBindBuffer(GL_PIXEL_PACK_BUFFER, 0);
+    glPixelStorei(GL_PACK_ROW_LENGTH, 0);
+    glPixelStorei(GL_PACK_ALIGNMENT, 1);
+    if (driver->HasArbGetTextureSubImage()) {
+        glGetTextureSubImage(Handle(1), level, 0, y, 0, width, rows, 1, tuple.format, tuple.type,
+                             static_cast<GLsizei>(size), out);
+    } else {
+        const OpenGLState prev_state = OpenGLState::GetCurState();
+        OpenGLState state = prev_state;
+        state.draw.read_framebuffer = runtime->read_fbos[FboIndex(type)].handle;
+        state.Apply();
+        Attach(GL_READ_FRAMEBUFFER, level, 0, true);
+        glReadPixels(0, y, width, rows, tuple.format, tuple.type, out);
+        prev_state.Apply();
+    }
+    glPixelStorei(GL_PACK_ALIGNMENT, 4);
+}
+
+void Surface::ChimeraWrite(u32 level, const void* pixels) {
+    glBindBuffer(GL_PIXEL_UNPACK_BUFFER, 0);
+    glPixelStorei(GL_UNPACK_ROW_LENGTH, 0);
+    glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
+    glActiveTexture(TEMP_UNIT);
+    glBindTexture(GL_TEXTURE_2D, Handle(1));
+    glTexSubImage2D(GL_TEXTURE_2D, level, 0, 0, ChimeraWidth(level), ChimeraHeight(level),
+                    tuple.format, tuple.type, pixels);
+    glPixelStorei(GL_UNPACK_ALIGNMENT, 4);
+}
+#endif
