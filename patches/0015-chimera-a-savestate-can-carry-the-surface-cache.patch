+#ifdef CHIMERA_CORE
+template <class T>
+void RasterizerCache<T>::ChimeraForEachRegistered(void (*fn)(void* ctx, Surface& surface),
+                                                  void* ctx) {
+    for (const auto& [page, surfaces] : page_table) {
+        for (const SurfaceId surface_id : surfaces) {
+            Surface& surface = slot_surfaces[surface_id];
+            // a surface is listed under every page it touches: its first one speaks for it
+            if ((surface.addr >> CITRA_PAGEBITS) == page) {
+                fn(ctx, surface);
+            }
+        }
+    }
+}
