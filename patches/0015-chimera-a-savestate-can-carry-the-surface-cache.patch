+#ifdef CHIMERA_CORE
+/// chimera: one registered surface of the cache, as a savestate has to carry it.
+/// A surface drawn larger than the console draws is a texture on the card and
+/// nowhere else: the console's memory holds it scaled down. A state that is to
+/// give the same run back keeps every registered surface - what it is, which of
+/// it is valid, and (the surface's own ChimeraRead) its pixels - and a cache
+/// made again after a load adopts them in the order they were registered in.
+/// `serial` and `tick` name a surface's pixels: a registration is numbered
+/// once, and every change to its pixels moves the tick.
+struct ChimeraSurfaceRecord {
+    SurfaceParams params;
+    SurfaceFlagBits flags;
+    u32 fill_size;
+    std::array<u8, 4> fill_data;
+    u64 serial;
+    u64 tick;
+    const PAddr* invalid; ///< invalid_count pairs: [lower, upper)
+    u32 invalid_count;
+};
+#endif
