@@ -109,7 +109,15 @@ u64 Handler::GetSystemTimeSince2000() const {
     epoch_tm.tm_mon = 0;
     epoch_tm.tm_year = 100;
     epoch_tm.tm_isdst = 0;
+#ifdef CHIMERA_CORE
+    // chimera: 2000-01-01 in UTC. mktime reads it in the HOST's time zone, so
+    // the console's clock was an hour apart between a host in Madrid and one in
+    // UTC - and the sandbox, which has no time zone, is one in UTC.
+    (void)epoch_tm;
+    s64 epoch = 946684800LL * 1000;
+#else
     s64 epoch = std::mktime(&epoch_tm) * 1000;
+#endif
 
     // Only when system time is after 2000, we set it as 3DS system time
     if (now.count() > epoch) {
