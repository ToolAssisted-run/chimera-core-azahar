     epoch_tm.tm_mon = 0;
     epoch_tm.tm_year = 100;
     epoch_tm.tm_isdst = 0;
+#ifdef CHIMERA_CORE
+    // chimera: in UTC, like the console's clock (see shared_page.cpp)
