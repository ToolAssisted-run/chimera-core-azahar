 AmiiboDate NfcDevice::GetAmiiboDate() const {
     auto now = GetCurrentTime();
+#ifdef CHIMERA_CORE
+    tm local_tm{};
+    gmtime_r(&now, &local_tm);
+#else
     tm local_tm = *localtime(&now);
+#endif
     AmiiboDate amiibo_date{};
 
     amiibo_date.SetYear(static_cast<u16>(local_tm.tm_year + 1900));
