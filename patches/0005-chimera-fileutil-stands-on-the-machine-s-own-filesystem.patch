--- /dev/null
+++ b/src/common/chimera_fs.h
@@ -0,0 +1,48 @@
+// Copyright 2026 Chimera
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+// chimera: the filesystem FileUtil stands on.
+//
+// Upstream keeps the console's NAND, SD card, save data and system data as a
+// folder tree on the host. A Chimera machine has no host folder: it runs in a
+// sandbox whose filesystem is a flat list of files mounted read-only, and
+// everything the console writes has to be part of the machine - in its own
+// memory, where a savestate carries it and a rewind takes it back.
+//
+// So under CHIMERA_CORE, FileUtil's POSIX primitives come here instead. The
+// implementation is the core's (waterbox/chimera-fs.cpp), not Azahar's: an
+// in-memory tree for everything written, and the project's files - the game,
+// aes_keys.txt, ... - served read-only from one host descriptor each.
+
+#pragma once
+
+#ifdef CHIMERA_CORE
+
+#include <cstdio>
+#include <optional>
+#include <string>
+#include <vector>
+#include <sys/stat.h>
+
+namespace ChimeraFS {
+
+/// stat(2): st_mode (S_IFREG or S_IFDIR) and st_size are filled. 0, or -1 and errno.
+int Stat(const std::string& path, struct stat* st);
+/// unlink(2), mkdir(2), rmdir(2), rename(2). 0, or -1 and errno.
+int Unlink(const std::string& path);
+int Mkdir(const std::string& path);
+int Rmdir(const std::string& path);
+int Rename(const std::string& from, const std::string& to);
+/// A directory's entries, sorted; nullopt when it is not a directory.
+std::optional<std::vector<std::string>> List(const std::string& dir);
+/// fopen(3): a stdio stream on the file, or nullptr and errno.
+std::FILE* Open(const std::string& path, const char* mode);
+/// Bytes of an open stream's file at an offset, not moving the stream.
+std::size_t ReadAt(std::FILE* f, void* data, std::size_t size, unsigned long long offset);
+/// ftruncate(2) on an open stream's file. 0, or -1 and errno.
+int Truncate(std::FILE* f, unsigned long long size);
+
+} // namespace ChimeraFS
+
+#endif
