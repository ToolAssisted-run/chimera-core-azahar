diff --git a/src/common/machine_random.h b/src/common/machine_random.h
new file mode 100644
index 0000000..184fe7f
--- /dev/null
+++ b/src/common/machine_random.h
@@ -0,0 +1,57 @@
+// Copyright 2026 Chimera
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+// chimera: the randomness a machine draws is part of the machine.
+//
+// Upstream seeds everything that wants random bytes from the host - CryptoPP's
+// AutoSeededRandomPool reads the OS's entropy, OpenSSL's RAND_bytes likewise -
+// which makes the console a different console on every run: its unique id and
+// MAC address, generated once when the config is created, the random data ssl:C
+// hands a game, the nonces NFC writes. A movie cannot replay on a machine like
+// that, and inside the sandbox there is no entropy to read at all.
+//
+// So there is one stream, in the machine's own memory: a savestate carries its
+// position, and every run of the same inputs draws the same numbers in the same
+// order. splitmix64 - small, and good enough for everything above, none of which
+// is protecting anything on a machine that only ever talks to itself.
+
+#pragma once
+
+#include <cstddef>
+#include <cstring>
+#include <cryptopp/cryptlib.h>
+#include "common/common_types.h"
+
+namespace Common::MachineRandom {
+
+inline u64 g_state = 0x3D5E1F2A6B7C8D90ULL;
+
+inline u64 Next() {
+    u64 z = (g_state += 0x9E3779B97F4A7C15ULL);
+    z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9ULL;
+    z = (z ^ (z >> 27)) * 0x94D049BB133111EBULL;
+    return z ^ (z >> 31);
+}
+
+inline void Fill(void* out, std::size_t size) {
+    u8* p = static_cast<u8*>(out);
+    while (size > 0) {
+        const u64 v = Next();
+        const std::size_t n = size < sizeof(v) ? size : sizeof(v);
+        std::memcpy(p, &v, n);
+        p += n;
+        size -= n;
+    }
+}
+
+/// A CryptoPP generator drawing from the machine's stream, for the places that
+/// hand one to CryptoPP (key validation, signing, the id generators).
+class Pool final : public CryptoPP::RandomNumberGenerator {
+public:
+    void GenerateBlock(CryptoPP::byte* output, std::size_t size) override {
+        Fill(output, size);
+    }
+};
+
+} // namespace Common::MachineRandom
